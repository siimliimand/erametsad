{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eametsad-api",
  // Entry shim: re-exports the OpenNext fetch handler from .open-next/worker.js
  // plus the DO classes and the queue consumer, because OpenNext's generated
  // entry cannot export them itself.
  "main": "src/do/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // wrangler 4 rejects the legacy top-level "bindings" array (it silently
  // drops those bindings), so producers sit next to the consumer config and
  // KV/R2 use their canonical sections.
  "kv_namespaces": [
    { "binding": "KV", "id": "5b67cd2c595f4d31b3b1be5db76e9bef" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "eametsad-media", "preview_bucket_name": "eametsad-media-preview" }
  ],
  // Email Sending beta (task 4.2): sending subdomain erametsad.ww0.dev is
  // onboarded on zone ww0.dev, which permits any local part and any
  // recipient, so no destination_address restriction applies here.
  // remote = true keeps `wrangler dev` on the real Email Service.
  "send_email": [{ "name": "EMAIL", "remote": true }],
  // No script_name: both classes are exported by this same Worker (the shim).
  "durable_objects": {
    "bindings": [
      { "name": "AUCTION", "class_name": "AuctionDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" }
    ]
  },
  // SQLite-backed DO classes need one migration entry; append future classes
  // as a new tag instead of editing v1.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuctionDO", "RateLimiterDO"]
    }
  ],
  // Producer binding for the jobs queue; the consumer below drains it.
  "queues": {
    "producers": [
      { "binding": "QUEUE", "queue": "eametsad-jobs" }
    ],
    // A message whose delivery fails max_retries times is routed to the DLQ by
    // the runtime; the consumer code only calls message.retry(). Create the
    // queues once from apps/platform:
    //   pnpm exec wrangler queues create eametsad-jobs
    //   pnpm exec wrangler queues create eametsad-dlq
    // DLQ-depth alerting lives in the Cloudflare dashboard (account-level queue
    // alerts), not in wrangler config; this comment is the wiring record.
    "consumers": [
      {
        "queue": "eametsad-jobs",
        "max_retries": 3,
        "dead_letter_queue": "eametsad-dlq"
      }
    ]
  },
  // Cron safety net (task 6.2): AuctionDO alarms own the end transition;
  // the every-minute scheduled() sweep in src/do/index.ts only wakes DOs
  // whose alarm was lost to eviction. See src/lib/workers/auction-ending.ts.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // TODO(task 2.8): the CI wrangler token lacks D1 write permission, so remote creation failed
  // (Authentication error, code 10000). A user with D1 access must run once from apps/platform:
  //   pnpm exec wrangler d1 create eametsad-db
  // then replace the placeholder database_id below with the returned uuid. Local dev ignores the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eametsad-db",
      "database_id": "6ffb35ca-6a2d-4447-9559-4dbc00b9a6c8",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
