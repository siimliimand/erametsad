{
  "name": "@eametsad/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "next lint && tsx scripts/lint-schema.ts",
    "lint:schema": "tsx scripts/lint-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:spike-d1 && pnpm test:spike-do",
    "test:unit": "vitest run",
    "test:spike-d1": "vitest run --config spikes/d1-drizzle/vitest.config.ts",
    "test:spike-do": "vitest run --config spikes/do/vitest.config.ts",
    "test:watch": "vitest",
    "seed:reset": "tsx src/payload/seed/reset.ts"
  },
  "dependencies": {
    "@eametsad/emails": "workspace:*",
    "@eametsad/types": "workspace:*",
    "@eametsad/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^15.0.0",
    "nodemailer": "^9.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@eametsad/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.127.0"
  }
}