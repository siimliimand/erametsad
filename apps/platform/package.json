{
  "name": "@erametsad/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "lint": "next lint && tsx scripts/lint-schema.ts",
    "lint:schema": "tsx scripts/lint-schema.ts",
    "migrate:pg:export": "tsx scripts/migrate-pg-to-d1/export-pg.ts",
    "migrate:pg:transform": "tsx scripts/migrate-pg-to-d1/transform.ts",
    "migrate:pg:import": "tsx scripts/migrate-pg-to-d1/import-d1.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:do && pnpm test:rate-limiter && pnpm test:queue-consumer && pnpm test:spike-d1 && pnpm test:spike-do && pnpm test:migrate-tool",
    "test:unit": "vitest run",
    "test:migrate-tool": "vitest run --config scripts/migrate-pg-to-d1/vitest.config.ts",
    "test:do": "vitest run --config src/do/__tests__/vitest.config.ts",
    "test:rate-limiter": "vitest run --config src/do/__tests__/rate-limiter/vitest.config.ts",
    "test:queue-consumer": "vitest run --config src/workers/__tests__/vitest.config.ts",
    "test:spike-d1": "vitest run --config spikes/d1-drizzle/vitest.config.ts",
    "test:spike-do": "vitest run --config spikes/do/vitest.config.ts",
    "test:watch": "vitest",
    "seed:reset": "tsx src/payload/seed/reset.ts"
  },
  "dependencies": {
    "@erametsad/emails": "workspace:*",
    "@erametsad/types": "workspace:*",
    "@erametsad/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "^15.0.0",
    "nodemailer": "^9.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@erametsad/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.13.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.127.0"
  }
}