{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary"
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny"
      }
    },
    "fullstack-engineer": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.3-flash"
    },
    "fullstack-engineer.build": {
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.3-flash"
    },
    "fullstack-engineer.fast": {
      "mode": "subagent",
      "model": "zai-coding-plan/glm-5.3-flash"
    }
  },
  "default_agent": "plan",
  "permission": {
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow"
  },
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "model": "zai-coding-plan/glm-5.3",
  "plugin": [
    "@slkiser/opencode-quota@4.2.0"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      },
      "enabled": true,
      "timeout": 120000
    }
  }
}