# Database (local)
DATABASE_URL="postgres://erametsad:erametsad@localhost:5432/erametsad"

# Neon serverless Postgres (set this to use @neondatabase/serverless over HTTP)
# NEON_DATABASE_URL="postgresql://..."

# DB type: "local" uses pg Pool, "neon" uses @neondatabase/serverless Pool
# If NEON_DATABASE_URL is set, neon is used automatically.
DB_TYPE="local"

# Redis
REDIS_URL="redis://localhost:6379"

# SMTP (Mailpit)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@erametsad.ee"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payload CMS (must be at least 32 chars)
PAYLOAD_SECRET="your-secret-key-change-in-production-min-32-chars"

# Field-level encryption (AES-256-GCM, keys must be 32 chars)
ISIKUKOOD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
SEALED_BID_ENCRYPTION_KEY="fedcba9876543210fedcba9876543210"

# Demo eID simulator (comma-separated isikukoods; empty uses built-in defaults)
# EID_DEMO_ISIKUKOOD=""