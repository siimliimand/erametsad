# Database (local)
DATABASE_URL="postgres://erametsad:erametsad@localhost:5432/erametsad"

# Neon serverless Postgres (set this to use @neondatabase/serverless over HTTP)
# NEON_DATABASE_URL="postgresql://..."

# DB type: "local" uses pg Pool, "neon" uses @neondatabase/serverless Pool
# If NEON_DATABASE_URL is set, neon is used automatically.
DB_TYPE="local"

