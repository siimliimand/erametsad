# Database: Cloudflare D1, binding "DB" in apps/platform/wrangler.jsonc.
# Local dev uses the local D1 state and needs no env variable.

# Redis
REDIS_URL="redis://localhost:6379"

# SMTP (Mailpit)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@erametsad.ee"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payload CMS (must be at least 32 chars)
PAYLOAD_SECRET="your-secret-key-change-in-production-min-32-chars"
# Preview mode secret (must be at least 16 chars)
PAYLOAD_PREVIEW_SECRET="preview-secret-change-me-16ch"
# HS256 signing secret for access/refresh JWTs (at least 32 chars)
JWT_SECRET="jwt-secret-change-in-production-min-32ch"

# Field-level encryption (AES-256-GCM, keys must be 32 chars)
ISIKUKOOD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
SEALED_BID_ENCRYPTION_KEY="fedcba9876543210fedcba9876543210"

# Demo eID simulator (comma-separated isikukoods; empty uses built-in defaults)
# EID_DEMO_ISIKUKOOD=""